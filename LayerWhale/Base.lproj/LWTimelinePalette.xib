<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24506" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24506"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="LWTimelinePalette">
            <connections>
                <outlet property="lastChangeFormatter" destination="0f1-PG-NQg" id="hQX-uL-EQs"/>
                <outlet property="optionsButton" destination="i28-1c-XM8" id="i9m-6o-mSc"/>
                <outlet property="optionsMenu" destination="Jvx-bx-nMD" id="DWd-Qz-QcV"/>
                <outlet property="recordButton" destination="Nfb-Fq-wlh" id="d86-eh-lL8"/>
                <outlet property="statusField" destination="gg5-LY-Jic" id="GIi-W7-elB"/>
                <outlet property="theView" destination="1" id="3Nu-gy-ryi"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView wantsLayer="YES" id="1">
            <rect key="frame" x="0.0" y="0.0" width="147" height="60"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <button toolTip="Toggle recording" allowsExpansionToolTips="YES" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="Nfb-Fq-wlh" userLabel="Record Button">
                    <rect key="frame" x="9" y="28" width="26" height="23"/>
                    <buttonCell key="cell" type="roundTextured" bezelStyle="texturedRounded" image="NSTouchBarRecordStartTemplate" imagePosition="only" alignment="center" alternateImage="NSTouchBarPauseTemplate" lineBreakMode="truncatingTail" borderStyle="border" imageScaling="proportionallyUpOrDown" inset="2" id="IJX-Wd-EOi">
                        <behavior key="behavior" pushIn="YES" changeContents="YES" lightByContents="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <constraints>
                        <constraint firstAttribute="width" constant="24" id="IgK-aw-hda"/>
                    </constraints>
                    <connections>
                        <action selector="toggleRecordingOnSelectedLayers:" target="-2" id="kpU-GN-1ZN"/>
                        <binding destination="-2" name="enabled" keyPath="selectedLayersCount" id="tN2-Cx-maM"/>
                    </connections>
                </button>
                <button toolTip="Launch player" allowsExpansionToolTips="YES" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="kCY-jk-JKL" userLabel="Play Button">
                    <rect key="frame" x="34" y="28" width="26" height="23"/>
                    <contentFilters>
                        <ciFilter name="CIFalseColor">
                            <configuration>
                                <ciColor key="inputColor0" red="0.12935026372050837" green="0.48044390391027514" blue="0.94509803920000002" alpha="1"/>
                                <ciColor key="inputColor1" red="1" green="1" blue="1" alpha="1"/>
                                <null key="inputImage"/>
                            </configuration>
                        </ciFilter>
                    </contentFilters>
                    <buttonCell key="cell" type="roundTextured" bezelStyle="texturedRounded" image="NSTouchBarPlayTemplate" imagePosition="only" alignment="center" borderStyle="border" imageScaling="proportionallyUpOrDown" inset="2" id="N4W-vP-MuO">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <constraints>
                        <constraint firstAttribute="width" constant="24" id="u4M-2X-wMj"/>
                    </constraints>
                    <connections>
                        <action selector="playActiveLayerTimeline:" target="-2" id="JV9-YI-2XR"/>
                        <binding destination="-2" name="enabled" keyPath="activeTimeline.frameCount" id="qDU-Vn-2ko"/>
                    </connections>
                </button>
                <segmentedControl verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="i28-1c-XM8">
                    <rect key="frame" x="110" y="28" width="28" height="23"/>
                    <constraints>
                        <constraint firstAttribute="width" constant="26" id="U0G-Vc-qW1"/>
                    </constraints>
                    <contentFilters>
                        <ciFilter name="CIFalseColor">
                            <configuration>
                                <ciColor key="inputColor0" red="0.0" green="0.0" blue="0.0" alpha="1"/>
                                <ciColor key="inputColor1" red="1" green="1" blue="1" alpha="1"/>
                                <null key="inputImage"/>
                            </configuration>
                        </ciFilter>
                    </contentFilters>
                    <segmentedCell key="cell" borderStyle="border" alignment="left" style="texturedRounded" trackingMode="momentary" id="6Wd-1c-UBK">
                        <font key="font" metaFont="label" size="11"/>
                        <segments>
                            <segment image="LWMenuTemplate" width="20"/>
                        </segments>
                    </segmentedCell>
                </segmentedControl>
                <button toolTip="Make checkpoint (⌥⌘X)" allowsExpansionToolTips="YES" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="cpw-8s-pIi" userLabel="Bookmark Button">
                    <rect key="frame" x="59" y="28" width="26" height="23"/>
                    <contentFilters>
                        <ciFilter name="CIFalseColor">
                            <configuration>
                                <ciColor key="inputColor0" red="1" green="0.046307195958373848" blue="0.74103410120558988" alpha="1"/>
                                <ciColor key="inputColor1" red="1" green="1" blue="1" alpha="1"/>
                                <null key="inputImage"/>
                            </configuration>
                        </ciFilter>
                    </contentFilters>
                    <buttonCell key="cell" type="roundTextured" bezelStyle="texturedRounded" image="LWBookmarkTemplate" imagePosition="only" alignment="center" borderStyle="border" imageScaling="proportionallyUpOrDown" inset="2" id="tVf-oS-X8I">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <string key="keyEquivalent">x</string>
                        <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                    </buttonCell>
                    <constraints>
                        <constraint firstAttribute="width" constant="24" id="iKr-Dc-F7Q"/>
                    </constraints>
                    <connections>
                        <action selector="makeCheckpoint:" target="-2" id="WKC-R7-0k8"/>
                        <binding destination="-2" name="enabled" keyPath="selectedLayersCount" id="7t3-D6-uKv"/>
                    </connections>
                </button>
                <button toolTip="Revert to checkpoint (⌥⌘Z)" allowsExpansionToolTips="YES" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="t7k-Fs-woc" userLabel="Revert Buton">
                    <rect key="frame" x="84" y="28" width="26" height="23"/>
                    <contentFilters>
                        <ciFilter name="CIFalseColor">
                            <configuration>
                                <ciColor key="inputColor0" red="0.0" green="0.67199492872456146" blue="0.52305206503491053" alpha="1"/>
                                <ciColor key="inputColor1" red="1" green="1" blue="1" alpha="1"/>
                                <null key="inputImage"/>
                            </configuration>
                        </ciFilter>
                    </contentFilters>
                    <buttonCell key="cell" type="roundTextured" bezelStyle="texturedRounded" image="LWRevertTemplate" imagePosition="only" alignment="center" borderStyle="border" imageScaling="proportionallyUpOrDown" inset="2" id="0nW-aI-jAg">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                        <string key="keyEquivalent">z</string>
                        <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                    </buttonCell>
                    <constraints>
                        <constraint firstAttribute="width" constant="24" id="OUY-bW-Mpa"/>
                    </constraints>
                    <connections>
                        <action selector="revertToLastCheckpoint:" target="-2" id="xT2-ke-uob"/>
                        <binding destination="-2" name="enabled" keyPath="activeTimeline.frameCount" id="Opt-Kz-Qao"/>
                    </connections>
                </button>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" translatesAutoresizingMaskIntoConstraints="NO" id="gg5-LY-Jic" userLabel="Status">
                    <rect key="frame" x="11" y="10" width="128" height="12"/>
                    <textFieldCell key="cell" controlSize="mini" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" id="3gX-RM-MJB">
                        <font key="font" metaFont="menu" size="9"/>
                        <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
            </subviews>
            <constraints>
                <constraint firstItem="t7k-Fs-woc" firstAttribute="top" secondItem="Nfb-Fq-wlh" secondAttribute="top" id="4Qs-wx-1qW"/>
                <constraint firstItem="Nfb-Fq-wlh" firstAttribute="top" secondItem="1" secondAttribute="top" constant="10" id="8U7-th-VcN"/>
                <constraint firstItem="Nfb-Fq-wlh" firstAttribute="leading" secondItem="1" secondAttribute="leading" constant="10" id="98X-eE-Ek2"/>
                <constraint firstItem="kCY-jk-JKL" firstAttribute="top" secondItem="Nfb-Fq-wlh" secondAttribute="top" id="C8O-ke-Omc"/>
                <constraint firstItem="cpw-8s-pIi" firstAttribute="top" secondItem="Nfb-Fq-wlh" secondAttribute="top" id="X39-pj-DlA"/>
                <constraint firstItem="t7k-Fs-woc" firstAttribute="leading" secondItem="cpw-8s-pIi" secondAttribute="trailing" constant="1" id="alJ-s7-NeN"/>
                <constraint firstAttribute="trailing" secondItem="i28-1c-XM8" secondAttribute="trailing" constant="10" id="euv-gQ-q5i"/>
                <constraint firstItem="kCY-jk-JKL" firstAttribute="leading" secondItem="Nfb-Fq-wlh" secondAttribute="trailing" constant="1" id="hlq-Xp-2v7"/>
                <constraint firstItem="i28-1c-XM8" firstAttribute="top" secondItem="Nfb-Fq-wlh" secondAttribute="top" id="kiw-cR-Raw"/>
                <constraint firstAttribute="trailing" secondItem="gg5-LY-Jic" secondAttribute="trailing" constant="10" id="lPf-cI-rNI"/>
                <constraint firstItem="cpw-8s-pIi" firstAttribute="leading" secondItem="kCY-jk-JKL" secondAttribute="trailing" constant="1" id="mxR-LB-evA"/>
                <constraint firstItem="gg5-LY-Jic" firstAttribute="leading" secondItem="1" secondAttribute="leading" constant="13" id="o4W-T4-7Xy"/>
                <constraint firstItem="gg5-LY-Jic" firstAttribute="top" secondItem="Nfb-Fq-wlh" secondAttribute="bottom" constant="8" symbolic="YES" id="puX-vf-E2e"/>
            </constraints>
            <point key="canvasLocation" x="118.5" y="172"/>
        </customView>
        <userDefaultsController representsSharedInstance="YES" id="LEU-O4-vf2"/>
        <menu id="Jvx-bx-nMD">
            <items>
                <menuItem title="Delete timeline" id="pCi-nJ-ATw">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="deleteTimeline:" target="-2" id="bLo-WI-ffX"/>
                        <binding destination="-2" name="enabled" keyPath="deleteButtonVisible" id="xzI-O8-EAf"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="gSe-93-ivf"/>
                <menuItem title="Preferences..." id="CnN-yh-M1G">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showPluginPreferences:" target="-2" id="Hfs-Ts-VjH"/>
                    </connections>
                </menuItem>
            </items>
            <point key="canvasLocation" x="364" y="294"/>
        </menu>
        <dateFormatter formatterBehavior="custom10_4" dateStyle="short" dateFormat="d MMM yy, H:mm:ss" id="0f1-PG-NQg"/>
    </objects>
    <resources>
        <image name="LWBookmarkTemplate" width="42" height="84"/>
        <image name="LWMenuTemplate" width="42" height="84"/>
        <image name="LWRevertTemplate" width="42" height="84"/>
        <image name="NSTouchBarPauseTemplate" width="14" height="17"/>
